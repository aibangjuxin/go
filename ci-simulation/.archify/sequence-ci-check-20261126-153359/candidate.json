{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "CI Check: Pull Request to Report Sequence",
    "subtitle": "GitHub Enterprise pull request to Cloud Build parent and child builds",
    "output": "ci-check-archify.html",
    "locale": "en",
    "quality_profile": "showcase",
    "feedback_links": false
  },
  "participants": [
    {
      "id": "dev",
      "type": "external",
      "label": "Developer",
      "sublabel": "opens the pull request"
    },
    {
      "id": "ghes",
      "type": "backend",
      "label": "GHES",
      "sublabel": "GitHub Enterprise Server"
    },
    {
      "id": "trigger",
      "type": "cloud",
      "label": "CB Trigger",
      "sublabel": "Cloud Build trigger"
    },
    {
      "id": "parent",
      "type": "cloud",
      "label": "Parent Build",
      "sublabel": "orchestrator"
    },
    {
      "id": "child",
      "type": "cloud",
      "label": "Child Build",
      "sublabel": "test runner"
    }
  ],
  "segments": [
    {
      "from": 140,
      "to": 268,
      "label": "Trigger"
    },
    {
      "from": 268,
      "to": 500,
      "label": "Parent preparation"
    },
    {
      "from": 500,
      "to": 652,
      "label": "Child tests"
    },
    {
      "from": 652,
      "to": 792,
      "label": "Report and gate"
    }
  ],
  "messages": [
    {
      "id": "m01-open-pr",
      "from": "dev",
      "to": "ghes",
      "y": 160,
      "label": "Open / update pull request",
      "variant": "default"
    },
    {
      "id": "m02-webhook",
      "from": "ghes",
      "to": "trigger",
      "y": 200,
      "label": "POST pull_request",
      "variant": "emphasis"
    },
    {
      "id": "m03-create-parent",
      "from": "trigger",
      "to": "parent",
      "y": 245,
      "label": "Create parent build",
      "variant": "emphasis",
      "note": "Filter + bindings: PR number, head SHA, repository"
    },
    {
      "id": "m04-verify-pr",
      "from": "parent",
      "to": "ghes",
      "y": 320,
      "label": "GET pull request: verify open and head (BOT token)",
      "variant": "security",
      "note": "Parent steps: validate-input, prepare-credentials"
    },
    {
      "id": "m05-pending",
      "from": "parent",
      "to": "ghes",
      "y": 395,
      "label": "POST statuses/{sha}: pending",
      "variant": "emphasis"
    },
    {
      "id": "m06-get-ci-tests",
      "from": "parent",
      "to": "ghes",
      "y": 435,
      "label": "GET ci-tests.yaml at head SHA",
      "variant": "default"
    },
    {
      "id": "m07-test-decls",
      "from": "ghes",
      "to": "parent",
      "y": 475,
      "label": "Return test declarations",
      "variant": "return"
    },
    {
      "id": "m08-create-child",
      "from": "parent",
      "to": "child",
      "y": 525,
      "label": "Create child build via API",
      "variant": "emphasis",
      "note": "run-tests: generate"
    },
    {
      "id": "m09-poll",
      "from": "parent",
      "to": "child",
      "y": 580,
      "label": "Poll child build API",
      "variant": "dashed"
    },
    {
      "id": "m10-child-result",
      "from": "child",
      "to": "parent",
      "y": 620,
      "label": "Status + step results",
      "variant": "return"
    },
    {
      "id": "m11-comment",
      "from": "parent",
      "to": "ghes",
      "y": 670,
      "label": "POST issues/{PR}/comments (BOT token)",
      "variant": "emphasis"
    },
    {
      "id": "m12-final-status",
      "from": "parent",
      "to": "ghes",
      "y": 710,
      "label": "POST statuses/{sha}: success / failure",
      "variant": "emphasis"
    },
    {
      "id": "m13-view-report",
      "from": "ghes",
      "to": "dev",
      "y": 750,
      "label": "View report + cloud-build/ci",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "ghes",
      "from": 160,
      "to": 770,
      "type": "backend"
    },
    {
      "participant": "trigger",
      "from": 200,
      "to": 245,
      "type": "cloud"
    },
    {
      "participant": "parent",
      "from": 245,
      "to": 730,
      "type": "cloud"
    },
    {
      "participant": "child",
      "from": 525,
      "to": 620,
      "type": "cloud"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Trigger and scheduling",
      "items": [
        "The pull_request event reaches the Cloud Build trigger on GHES",
        "The trigger filters the event and binds the PR number, head SHA and repository into the build",
        "The parent build is created from that binding"
      ]
    },
    {
      "dot": "emerald",
      "title": "Parent build orchestrates",
      "items": [
        "validate-input and prepare-credentials run before any GitHub call",
        "Every GHES call is made with the BOT token, so the bot identity stays auditable",
        "A pending commit status is posted before the tests start",
        "ci-tests.yaml at the head SHA decides which tests run",
        "run-tests: generate produces the child build spec and the parent polls the Cloud Build API"
      ]
    },
    {
      "dot": "violet",
      "title": "Child build runs the tests",
      "items": [
        "prepare NETRC, then clone the repository and check out the head SHA",
        "Step 1: install dependencies",
        "Step 2: Helm lint and render",
        "Step 3: Python unit tests",
        "Step 4: Bash mock tests",
        "The parent receives the status and the per-step results"
      ]
    },
    {
      "dot": "orange",
      "title": "Report and gate",
      "items": [
        "report-result aggregates the step results into a Markdown report",
        "The bot posts the report as a pull request comment",
        "The commit status carries the pass/fail signal used by branch protection",
        "The developer reads the report and the cloud-build/ci link on the pull request"
      ]
    }
  ]
}