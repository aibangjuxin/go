  "cards": [
    {
      "dot": "cyan",
      "title": "Trigger and scheduling",
      "items": [
        "pull_request event reaches the Cloud Build 2nd-gen trigger",
        "Trigger filters the event (opened / synchronize only) and binds PR number, head SHA and repo into the build",
        "The parent build is created from that binding"
      ]
    },
    {
      "dot": "emerald",
      "title": "Parent build orchestrates",
      "items": [
        "validate-input and prepare-credentials run before any GitHub call",
        "Every GHES call uses the pull-report-bot token (issues:write, statuses:write)",
        "A pending commit status is posted before the tests start",
        "ci-tests.yaml at the head SHA decides which tests to run",
        "run-tests: generate produces the child build spec, the parent polls the Cloud Build API"
      ]
    },
    {
      "dot": "violet",
      "title": "Child build runs the tests",
      "items": [
        "Four steps: install dependencies, helm lint + render, python unit tests, bash mock tests",
        "Each step is a fresh container, only /workspace is shared between steps",
        "Results return as step exit codes and logs"
      ]
    },
    {
      "dot": "orange",
      "title": "Report and gate",
      "items": [
        "report-result aggregates step results into a Markdown report",
        "pull-report-bot posts the report as a PR comment",
        "The commit status carries the pass/fail signal used by branch protection",
        "A hidden marker keeps one comment updated instead of spamming the PR"
      ]
    }
  ]
